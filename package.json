{
  "name": "@tonyweckstrom/mcp-doctor",
  "version": "0.3.0",
  "description": "Terveystarkastus MCP-palvelimelle: initialize-kättely, työkalujen skeemojen tarkistus ja savuajo, raportti ja exit-koodi CI:lle. / Health check for MCP servers: handshake, tool schema lint and smoke calls, with a CI-friendly exit code.",
  "license": "MIT",
  "author": "Tony Weckström",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyweckstrom1987/mcp-doctor.git"
  },
  "homepage": "https://github.com/tonyweckstrom1987/mcp-doctor#readme",
  "bugs": {
    "url": "https://github.com/tonyweckstrom1987/mcp-doctor/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "health-check",
    "lint",
    "ci",
    "github-action"
  ],
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "mcp-doctor": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test",
    "demo:ennen": "node dist/bin.js --strict --smoke examples/demo/savuajo.json -- node examples/demo/ennen.mjs",
    "demo:jalkeen": "node dist/bin.js --strict --smoke examples/demo/savuajo.json -- node examples/demo/jalkeen.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
